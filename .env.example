# OMDb API Key (Optional for IMDb ID searches resolved via Cinemeta; required for title text search)
OMDB_API_KEY=your_omdb_api_key_here

# Comet URL (optional, defaults to elfhosted public instance)
# COMET_URL=https://comet.elfhosted.com/e30=/stream/

# Dynamic Custom Addons (comma-separated addon_name=url)
# CUSTOM_ADDONS=addon1=https://addon1.strem.fun/stream/,addon2=https://addon2.strem.fun/stream/

# Performance & Resilience Tuning
# DISABLED_PROVIDERS=meteor,thepiratebay-plus
# FETCH_ALL_TIMEOUT=5.5
# CONNECT_TIMEOUT=2.0
# READ_TIMEOUT=4.0
# CB_FAILURE_THRESHOLD=3
# CB_COOLDOWN_SECONDS=180
# NEGATIVE_CACHE_TTL=60
