# OMDb API Key (Required for title to IMDB ID conversion)
OMDB_API_KEY=your_omdb_api_key_here

# Comet URL (optional, defaults to elfhosted public instance)
# COMET_URL=https://comet.elfhosted.com/e30=/stream/

# Dynamic Custom Addons (comma-separated addon_name=url)
# CUSTOM_ADDONS=addon1=https://addon1.strem.fun/stream/,addon2=https://addon2.strem.fun/stream/
